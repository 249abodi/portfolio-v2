# Portfolio AI assistant — server-side only. Never prefix these with NEXT_PUBLIC_.

# Required. Without it, /api/chat returns 503 and the widget offers the email fallback.
# Google AI Studio key (free tier). Used only inside the server route; never sent to the browser.
OPENAI_API_KEY=

# Required in practice — Gemini's OpenAI-compatible endpoint. Trailing slash optional.
# The route appends /chat/completions.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Must be a model this key can actually reach.
# Verified against the live API: gemini-3.5-flash is listed for this key and
# streams correctly. The 2.5 family returns HTTP 404 ("not available to new
# users"), so do not downgrade to it.
#
# The binding constraint is quota, not the model name. The free tier allows
# generate_content_free_tier_requests = 20 requests PER DAY, per project, per
# model — shared by every visitor on the site, and reset at midnight Pacific.
# After that is spent the API returns HTTP 429 "You exceeded your current
# quota". Quotas are per project, not per API key.
OPENAI_MODEL=gemini-3.5-flash

# Used for absolute URLs in metadata, sitemap, and the assistant's knowledge base.
# NEXT_PUBLIC_SITE_URL=https://249abodii.vercel.app
